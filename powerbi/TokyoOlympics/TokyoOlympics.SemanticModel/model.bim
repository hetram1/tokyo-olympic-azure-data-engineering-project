        ],
        "description": "One row per country/delegation in the pinned Tokyo Olympics dataset. No time series or athlete gender is inferred.",
        "lineageTag": "2987c0c3-101c-4f52-99ed-e6b2123c248f",
        "measures": [
          {
            "name": "Total Medals",
            "description": "Total Medals for the current country selection.",
            "displayFolder": "Core metrics",
            "expression": "SUM(CountryResults[Total])",
            "formatString": "#,0",
            "lineageTag": "93c6fbf1-7545-48df-a4bb-334b2e1a442c"
          },
          {
            "name": "Gold Medals",
            "description": "Gold Medals for the current country selection.",
            "displayFolder": "Core metrics",
            "expression": "SUM(CountryResults[Gold])",
            "formatString": "#,0",
            "lineageTag": "16c2e9b8-5b29-49b6-a842-7c7f87f8862b"
          },
          {
            "name": "Silver Medals",
            "description": "Silver Medals for the current country selection.",
            "displayFolder": "Core metrics",
            "expression": "SUM(CountryResults[Silver])",
            "formatString": "#,0",
            "lineageTag": "1ac31935-de70-4369-b91d-0d7107eebee7"
          },
          {
            "name": "Bronze Medals",
            "description": "Bronze Medals for the current country selection.",
            "displayFolder": "Core metrics",
            "expression": "SUM(CountryResults[Bronze])",
            "formatString": "#,0",
            "lineageTag": "3ea7ed36-8dd6-4cc2-917f-326c433356d5"
          },
          {
            "name": "Athletes",
            "description": "Athletes for the current country selection.",
            "displayFolder": "Core metrics",
            "expression": "SUM(CountryResults[athlete_count])",
            "formatString": "#,0",
            "lineageTag": "193b80f2-c013-4e34-919c-ae3eb6ad753f"
          },
          {
            "name": "Team Entries",
            "description": "Team Entries for the current country selection.",
            "displayFolder": "Core metrics",
            "expression": "SUM(CountryResults[team_count])",
            "formatString": "#,0",
            "lineageTag": "75264b32-0639-4516-ac23-eed1e8a95960"
          },
          {
            "name": "Countries",
            "description": "Country/delegation rows in this snapshot; includes refugee and neutral delegations as represented in the source.",
            "displayFolder": "Core metrics",
            "expression": "COUNTROWS(CountryResults)",
            "formatString": "#,0",
            "lineageTag": "0f2256f9-02d3-4224-8225-040edacf5104"
          },
          {
            "name": "Medal Countries",
            "description": "Medal Countries for the current country selection.",
            "displayFolder": "Core metrics",
            "expression": "CALCULATE(COUNTROWS(CountryResults), KEEPFILTERS(CountryResults[Total] > 0))",
            "formatString": "#,0",
            "lineageTag": "901b474b-61bf-4686-87e1-51e8e2206973"
          },
          {
            "name": "Medals per 100 Athletes",
            "description": "100 × aggregate medal awards divided by listed unique athlete names within country. Not a personal medal probability; team medal accounting differs.",
            "displayFolder": "Core metrics",
            "expression": "100 * DIVIDE([Total Medals], [Athletes], 0)",
            "formatString": "0.00",
            "lineageTag": "e62e7607-8687-4504-83ab-109116ccd779"
          },
          {
            "name": "Gold Share",
            "description": "Gold medals divided by all medal awards for the current selection; ratio of sums, never an average of country percentages.",
            "displayFolder": "Core metrics",
            "expression": "DIVIDE([Gold Medals], [Total Medals], 0)",
            "formatString": "0.0%",
            "lineageTag": "5862f7c1-e243-4ffe-9fa6-95c2ea8027d6"
          },
          {
            "name": "Medal Rank in Selection",
            "description": "Medal Rank in Selection for the current country selection.",
            "displayFolder": "Chart helpers",
            "expression": "RANKX(ALLSELECTED(CountryResults[country]), [Total Medals], , DESC, SKIP)",
            "formatString": "#,0",
            "isHidden": true,
            "lineageTag": "2545e74d-2c11-4f7f-980c-353a264578b3"
          },
          {
            "name": "Gold Top Countries",
            "description": "Gold Top Countries for the current country selection.",
            "displayFolder": "Chart helpers",
            "expression": "IF([Medal Rank in Selection] <= 10 && [Total Medals] > 0, [Gold Medals])",
            "formatString": "#,0",
            "isHidden": true,
            "lineageTag": "dfe4cdb5-4eba-4807-9a22-408a99bb0edf"
          },
          {
            "name": "Silver Top Countries",
            "description": "Silver Top Countries for the current country selection.",
            "displayFolder": "Chart helpers",
            "expression": "IF([Medal Rank in Selection] <= 10 && [Total Medals] > 0, [Silver Medals])",
            "formatString": "#,0",
            "isHidden": true,
            "lineageTag": "696702c1-63ac-43c9-ba44-2f1c61cb0510"
          },
          {
            "name": "Bronze Top Countries",
            "description": "Bronze Top Countries for the current country selection.",
            "displayFolder": "Chart helpers",
            "expression": "IF([Medal Rank in Selection] <= 10 && [Total Medals] > 0, [Bronze Medals])",
            "formatString": "#,0",
            "isHidden": true,
            "lineageTag": "552e420a-784b-4faa-8194-2028a92ddb90"
          },
          {
            "name": "Efficiency Top Countries",
            "description": "Efficiency Top Countries for the current country selection.",
            "displayFolder": "Chart helpers",
            "expression": "VAR Eligible = FILTER(ALLSELECTED(CountryResults[country]), CALCULATE([Athletes]) >= 20) RETURN IF([Athletes] >= 20 && RANKX(Eligible, [Medals per 100 Athletes], , DESC, SKIP) <= 10, [Medals per 100 Athletes])",
            "formatString": "0.00",
            "isHidden": true,
            "lineageTag": "c944f4c1-b088-4d78-bdf2-5b628f3efcc6"
          },
          {
            "name": "Total Top Countries",
            "description": "Total medals for top ten ranks in the current selection; blank outside this set.",
            "displayFolder": "Chart helpers",
            "expression": "IF([Medal Rank in Selection] <= 10 && [Total Medals] > 0, [Total Medals])",
            "formatString": "#,0",
            "isHidden": true,
            "lineageTag": "dd77457e-3b3f-4a3e-9855-b816977f687f"
          }
        ],
        "partitions": [
          {
            "name": "CountryResults",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\",\", Columns=16, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"country\", type text}, {\"athlete_count\", Int64.Type}, {\"athlete_discipline_count\", Int64.Type}, {\"team_count\", Int64.Type}, {\"team_discipline_count\", Int64.Type}, {\"team_event_count\", Int64.Type}, {\"Gold\", Int64.Type}, {\"Silver\", Int64.Type}, {\"Bronze\", Int64.Type}, {\"Total\", Int64.Type}, {\"medal_rate_per_athlete\", type number}, {\"gold_share\", type number}, {\"medals_per_discipline\", type number}, {\"performance_class\", type text}, {\"medal_rank\", Int64.Type}, {\"performance_label\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
}